# Used by both PyMongo (direct) and MongoDB MCP Server (via npx mongodb-mcp-server)
MONGODB_URI=mongodb+srv://<user>:<password>@casepilot.xxxxx.mongodb.net/?appName=casepilot
MONGODB_DB=casepilot
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
